{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikasir.github.io/ha-nikas-house/schemas/navigation.schema.json",
  "title": "NikaS navigation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "nikas.home-assistant/navigation/v1"},
    "kind": {"const": "NavigationContract"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "version": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
        "description": {"type": "string"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes", "global_tabs"],
      "properties": {
        "routes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9._-]*$"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "path"],
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "path": {"type": "string", "pattern": "^/[a-z0-9][a-z0-9/_-]*$"},
              "parent": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}
            }
          }
        },
        "global_tabs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "route", "title", "icon"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
              "route": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
              "title": {"type": "string", "minLength": 1},
              "icon": {"type": "string", "pattern": "^mdi:[a-z0-9-]+$"}
            }
          }
        },
        "tab_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "dashboard_path", "parent", "tabs"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
              "title": {"type": "string", "minLength": 1},
              "dashboard_path": {"type": "string", "pattern": "^/[a-z0-9][a-z0-9/_-]*$"},
              "parent": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
              "tabs": {
                "type": "array",
                "minItems": 2,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["view", "title", "icon"],
                  "properties": {
                    "view": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
                    "title": {"type": "string", "minLength": 1},
                    "icon": {"type": "string", "pattern": "^mdi:[a-z0-9-]+$"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
