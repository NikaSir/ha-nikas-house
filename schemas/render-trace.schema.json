{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikasir.github.io/ha-nikas-house/schemas/render-trace.schema.json",
  "title": "NikaS House render trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "manifest",
    "contracts",
    "inventory_snapshot_ids",
    "bindings",
    "semantics",
    "renderer_engine_sha256",
    "dashboard_sha256"
  ],
  "properties": {
    "api_version": {
      "const": "nikas.home-assistant/render-trace/v1"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "dashboard_path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "dashboard_path": {
          "type": "string",
          "pattern": "^/[a-z0-9][a-z0-9/_-]*$"
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "inventory_snapshot_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "semantic_key",
          "entity_id"
        ],
        "properties": {
          "semantic_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*){2,}$"
          },
          "entity_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"
          }
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "views"
      ],
      "properties": {
        "views": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/view"
          }
        }
      }
    },
    "renderer_engine_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dashboard_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "navigate"
            },
            "target": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "more_info",
                "toggle",
                "none"
              ]
            }
          }
        }
      ]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "label",
        "semantic_key",
        "entity_id",
        "domain",
        "action"
      ],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "semantic_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*){2,}$"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance",
        "contract",
        "order",
        "title",
        "renderer",
        "columns",
        "roles"
      ],
      "properties": {
        "instance": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "contract": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "renderer": {
          "const": "tiles_v1"
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role"
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "path",
        "order",
        "modules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          }
        }
      }
    }
  }
}
